# MySQL（容器内通过 Compose 服务名 mysql 访问）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=multichateval
MYSQL_USER=multichateval
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# 宿主机访问端口；容器内部端口固定为后端 8000、前端 5174。
BACKEND_PORT=8000
FRONTEND_PORT=5174

# Backend
APP_NAME=MultiChatEval
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
DATABASE_URL=mysql+aiomysql://multichateval:CHANGE_ME@mysql:3306/multichateval

# RAG 私有依赖；不映射到宿主机，后端和 Worker 只读取模型缓存。
RAG_EMBEDDING_URL=http://embedding:80
RAG_QDRANT_URL=http://qdrant:6333
RAG_REDIS_URL=redis://redis:6379/0
RAG_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
RAG_MODEL_CACHE_DIR=/data
RAG_DOCUMENTS_DIR=/documents
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_MAX_BATCH_TOKENS=2048
RAG_EMBEDDING_TIMEOUT_SECONDS=60
